ADMIN_PASSWORD=changeme123

# 可选：留空则首次启动自动生成并持久化到 SQLite
JWT_SECRET=
INTERNAL_SECRET=

# 可选：也可在后台「系统设置」中修改
SUBCONVERTER_URL=http://127.0.0.1:25500
INTERNAL_BASE_URL=http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
SITE_TITLE=Runway
